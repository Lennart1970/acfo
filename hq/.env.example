# Demo mode works with no secrets. Data is stored in .data/hq.json.

# Public URL of this HQ app (used in Slack messages and OAuth redirects)
HQ_APP_URL=http://localhost:3000

# Set to false in production if you do not want the demo login
HQ_ALLOW_DEMO=true

# Optional: persist HQ in Supabase instead of the local JSON file
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slack app (see slack-manifest.json)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
# After installing Grok for Slack, paste the Grok bot user id (U…)
SLACK_GROK_USER_ID=

# Cursor Cloud Agents API key (Dashboard → API Keys)
CURSOR_API_KEY=
