{
  "swagger": "2.0",
  "info": {
    "title": "acfo ledger",
    "description": "Exact Online grootboekmutaties via Invantive/acfo SQL replica. Read-only.",
    "version": "1.0"
  },
  "host": "REPLACE-WITH-RAILWAY-DOMAIN.up.railway.app",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": [],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Api-Key"
    }
  },
  "security": [{ "api_key": [] }],
  "paths": {
    "/api/lines": {
      "get": {
        "operationId": "GetLedgerLines",
        "summary": "Ledger lines",
        "description": "Transaction lines. line_number 0 (booking header) is excluded unless include_headers=true. type 40 = bank/cash.",
        "parameters": [
          { "name": "date_from", "in": "query", "type": "string", "format": "date", "required": false },
          { "name": "date_to", "in": "query", "type": "string", "format": "date", "required": false },
          { "name": "type", "in": "query", "type": "integer", "required": false, "description": "20 sales, 30 purchase, 40 bank/cash, 70 memorial" },
          { "name": "journal_code", "in": "query", "type": "string", "required": false },
          { "name": "gl_account_code", "in": "query", "type": "string", "required": false },
          { "name": "q", "in": "query", "type": "string", "required": false, "description": "Search description, relation, GL description" },
          { "name": "include_headers", "in": "query", "type": "boolean", "required": false },
          { "name": "limit", "in": "query", "type": "integer", "required": false, "default": 200, "maximum": 500 },
          { "name": "offset", "in": "query", "type": "integer", "required": false, "default": 0 }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "$ref": "#/definitions/LedgerPage" }
          },
          "401": { "description": "Missing or wrong X-Api-Key" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "Health",
        "summary": "Health",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "definitions": {
    "LedgerPage": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "amount_dc": { "type": "string", "description": "Sum of amount_dc over the filter, decimal string" },
        "source": { "type": "string" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/definitions/LedgerLine" }
        }
      }
    },
    "LedgerLine": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "journal_code": { "type": "string" },
        "entry_number": { "type": "integer" },
        "line_number": { "type": "integer" },
        "gl_account_code": { "type": "string" },
        "gl_account_description": { "type": "string" },
        "account_name": { "type": "string" },
        "description": { "type": "string" },
        "amount_dc": { "type": "string", "description": "Decimal string, administration currency" },
        "type": { "type": "integer" },
        "division": { "type": "integer" }
      }
    }
  }
}
