# Exact Online app (App Center → Manage my apps)
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
# Must be HTTPS and match the registered redirect URI exactly.
# After login Exact redirects here; paste the full URL back into `acfo auth`.
EXACT_REDIRECT_URI=https://localhost/callback
# nl | be | de | uk | fr | es | com
EXACT_REGION=nl
# Leave empty to use CurrentDivision from /api/v1/current/Me
EXACT_DIVISION=

# Where OAuth tokens are stored locally (chmod 600). On Railway, tokens go in Supabase oauth_tokens.
EXACT_TOKEN_FILE=.tokens.json

# MVP destination: Supabase session pooler (port 5432, user postgres.<project-ref>).
# When set, acfo uses Postgres and ignores MySQL.
# The ledger web view (`python -m acfo web`) reads this SQL. `--demo` skips it.
DATABASE_URL=

# Web view. LEDGER_SOURCE: transaction_lines_incremental (acfo sync, default)
# or transaction_lines_invantive (Invantive Data Hub, invantive/copy-to-supabase.sql).
# LEDGER_API_KEY protects /api/lines (header X-Api-Key). Empty = open; only for localhost.
LEDGER_SOURCE=
LEDGER_API_KEY=

# Optional MySQL fallback (only if DATABASE_URL is empty)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=acfo
MYSQL_PASSWORD=acfo
MYSQL_DATABASE=acfo
